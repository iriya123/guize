
EMUELEC:~/roms/mame # echo "=echo "===== 1. 搜索带人数标记的 ROM 文件名 ====="
find /storage/roms/arcade \
     /storage/roms/fbneo \
     /storage/roms/pgm2 \
     /storage/roms/ports \
     -type f 2>/dev/null |
grep -Ei '(^|[/_. -])(4p|4player|4players|4人|四人|6p|6player|6players|6人|多人)([/_. -]|$)'

echo
echo "===== 2. 查找游戏说明文件 ====="
find /storage/roms/arcade \
     /storage/roms/fbneo \
     /storage/roms/pgm2 \
     /storage/roms/ports \
     -type f \( \
       -iname '*.txt' -o \
       -iname '*.nfo' -o \
       -iname '*.md' -o \
       -iname '*.xml' \
     \) 2>/dev/null |
head -n 200

echo
echo "===== 3. 检查忍者神龟相关文件 ====="
find /storage/roms/arcade \
     /storage/roms/fbneo \
     /storage/roms/pgm2 \
     /storage/roms/ports \
     -type f 2>/dev/null |
grep -Ei 'tmnt|turtles|忍者神龟|施莱德'
