      print "===== " FILENAME " ====="
      n=split(block,a,"\n")
      for (i=1;i<=n;i++)h>|<name>|<players>/)
        if (a[i] ~ /<path>|<name>|<players>/)
          print a[i]
    }nside=0
    inside=0
  }' "$f"
done
