EMUELEC:~/roms/mame # echo "===== 游戏说明中的多人标记 ====="

find /storage/roms/arcade \
     /storage/roms/fbneo \
     /storage/roms/pgm2 \
     /storage/roms/ports \
     -type f \( \
       -name 'gamelist.xml' -o \
       -name 'metadata.pegasus.txt' -o \
       -name '列表.xml' -o \
       -name 'tmntsr.md' \
     \) 2>/dev/null |
while IFS= read -r f; do
  grep -inE '4[[:space:]]*(players?|人|p)|四人|4P|6[[:space:]]*(players?|人|p)|六人|多人|支持.{0,10}(人|player)|player.{0,10}(4|6)' "$f" 2>/dev/null |
  cut -c1-400 |
  while IFS= read -r line; do
    echo "文件：$f"
    echo "$line"
  done
done
