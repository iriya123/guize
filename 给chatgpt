echo "===== 1. 压缩工具实际位置 ====="
for x in 7z 7zz 7za unzip bsdtar busybox file; do
  echo "--- $x ---"
  command -v "$x" 2>/dev/null
done

echo "===== 2. BusyBox 支持的压缩功能 ====="
busybox --list 2>/dev/null | grep -E '^(unzip|tar|7z|file)$'

echo "===== 3. 检查一个 7z 文件头 ====="
if command -v od >/dev/null 2>&1; then
  od -An -tx1 -N8 \
    "/storage/roms/arcade/动作闯关街机/simpsons.7z"
fi

echo "===== 4. 查看 EmulationStation 系统配置 ====="
for f in \
  /storage/.config/emulationstation/es_systems.cfg \
  /etc/emulationstation/es_systems.cfg \
  /usr/config/emulationstation/es_systems.cfg
do
  if [ -r "$f" ]; then
    echo "--- $f ---"
    grep -n -E 'name>|fullname>|path>|extension>|command>|platform>' "$f" \
      | grep -i -E 'mame|arcade|fbneo|pgm|ports|path>|extension>|command>|platform>'
  fi
done
